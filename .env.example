# Налаштування для локальної розробки та деплою

# Для деплою через Docker (Coolify) SQLite база збережеться в папку /app/prisma
DATABASE_URL="file:./dev.db"

# Обов'язкові секрети для авторизації (NextAuth)
# Згенеруйте випадкову стрічку для секрету
NEXTAUTH_SECRET="your-super-secret-key-change-it-for-production"

# Вкажіть тут ваш домен або тимчасове посилання від Coolify
NEXTAUTH_URL="https://voltpremium.ua"
