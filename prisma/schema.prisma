// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?
  password  String
  role      String    @default("CLIENT")
  createdAt DateTime  @default(now())
  projects  Project[]
  messages  Message[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]
  quotes      Quote[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  senderId  String   
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Quote {
  id          String       @id @default(cuid())
  title       String
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      String       @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED
  totalAmount Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  groups      QuoteGroup[]
  history     QuoteHistory[]
}

model QuoteHistory {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  action    String   // "CREATED", "EDITED", "STATUS_CHANGED"
  details   String?  // Text description of the change
  userId    String?  // Who made the change (admin or client)
  createdAt DateTime @default(now())
}

model QuoteGroup {
  id      String      @id @default(cuid())
  title   String
  quoteId String
  quote   Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items   QuoteItem[]
  order   Int         @default(0)
}

model QuoteItem {
  id          String     @id @default(cuid())
  name        String
  description String?
  quantity    Float      @default(1)
  unit        String     @default("шт")
  price       Float
  total       Float
  photoUrl    String?
  groupId     String
  group       QuoteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order       Int        @default(0)
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String
  image           String?
  metaTitle       String?
  metaDescription String?
  author          String   @default("VOLT PREMIUM")
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PortfolioProject {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  category         String
  coverImage       String
  shortDescription String
  content          String   // Rich Text
  totalPrice       String?
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  media            ProjectMedia[]
}

model ProjectMedia {
  id         String   @id @default(cuid())
  url        String
  type       String   @default("IMAGE") // IMAGE or VIDEO
  projectId  String
  project    PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model PriceItem {
  id        String   @id @default(cuid())
  name      String
  unit      String
  price     Float
  category  String?
  isPublic  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model ClientRequest {
  id           String   @id @default(cuid())
  name         String
  phone        String
  serviceType  String
  comment      String?
  totalPrice   Float?
  attachedFile String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
}

model ServicePage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  icon            String
  advantages      String   // JSON stringified array of strings
  metaTitle       String?
  metaDescription String?
  image           String?
  content         String?  // Rich text or long description
  estimatedPrice  String?
  components      String?  // JSON or text
  included        String?  // JSON or text
  isFeatured      Boolean  @default(false)
  category        String   @default("Основні послуги")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StandardItem {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkStep {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

